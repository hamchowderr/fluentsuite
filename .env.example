# Copy to .env (never commit it) or set these in your MCP client config.
FLUENTSUITE_SITE_URL=https://your-site.example
FLUENTSUITE_WP_USER=your-wordpress-username
FLUENTSUITE_WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
# Comma-separated products to serve. Available today: crm, smtp, forms
FLUENTSUITE_PRODUCTS=crm
# FLUENTSUITE_PRODUCTS=crm,smtp,forms   # smtp needs the FluentSuite Bridge plugin on the site
# FLUENTSUITE_FORMS_REDACT_FIELDS=date of birth,medical   # extra field words always shown as [redacted]
# Read-only unless set to true
FLUENTSUITE_WRITES=false
# Allow crm_send_campaign (send/schedule email). Needs FLUENTSUITE_WRITES=true too.
FLUENTSUITE_ALLOW_SENDING=false
# Writes touching more records than this need explicit confirmation
FLUENTSUITE_BULK_THRESHOLD=10
# Hosted HTTP only
FLUENTSUITE_HTTP_HOST=127.0.0.1
FLUENTSUITE_HTTP_PORT=3333
# Required when FLUENTSUITE_HTTP_HOST is not loopback (min 24 chars)
FLUENTSUITE_HTTP_TOKEN=
# Set when running several instances behind a load balancer (min 16 chars)
FLUENTSUITE_CONFIRM_SECRET=
FLUENTSUITE_LOG_LEVEL=info
