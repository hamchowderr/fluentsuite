{
  "name": "@fluentsuite/crm",
  "version": "0.1.0",
  "private": true,
  "description": "FluentSuite module for FluentCRM: task-shaped MCP tools, MCP Apps views and Skills. Not affiliated with WPManageNinja.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@fluentsuite/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "fluentsuite-crm": "./dist/bin.js"
  },
  "files": [
    "dist",
    "skills",
    "ui-dist"
  ],
  "scripts": {
    "build:ui": "node ../core/scripts/build-views.mjs ui-dist ui/contact-card.ts ../core/ui/action-preview.ts",
    "build": "pnpm build:ui && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json"
  },
  "dependencies": {
    "@fluentsuite/core": "workspace:*",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@copilotkit/aimock": "1.45.0",
    "@modelcontextprotocol/client": "2.3.1",
    "playwright-core": "1.56.1"
  }
}
