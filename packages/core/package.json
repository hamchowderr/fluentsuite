{
  "name": "@fluentsuite/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared core for FluentSuite: WordPress REST client, paging, errors, safety layer, MCP Apps UI kit and Skills loader.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@fluentsuite/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@fluentsuite/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./ui-kit": {
      "@fluentsuite/source": "./ui/kit.ts",
      "default": "./ui/kit.ts"
    },
    "./build-views": "./scripts/build-views.mjs"
  },
  "files": [
    "dist",
    "ui",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.6",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    }
  }
}
